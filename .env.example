# Copy this file to .env and fill in your own values before running the app.

# Port the server listens on (local dev only - Vercel ignores this)
PORT=3000

# Long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Google Cloud Vision API key, used server-side to OCR uploaded/scanned
# forms. Get one at https://console.cloud.google.com (enable the Cloud
# Vision API, then create a key under APIs & Services -> Credentials).
# This key is shared by the whole app - it is not something individual
# users enter or store, and it never reaches the browser.
GOOGLE_VISION_API_KEY=replace_this_with_your_google_vision_api_key

# The app-wide cap on Vision API calls per calendar month, shared across
# every user of this deployment. Defaults to 500, well under Google's 1,000
# free requests/month, so normal use should never incur charges. See
# lib/quota.js and README.md ("Staying on the free tier") for details.
MONTHLY_OCR_LIMIT=500

# --- Firebase (Firestore database) ---
# Data lives in Firestore instead of a local file, since Vercel's serverless
# functions don't have a persistent filesystem. Create a Firebase project at
# https://console.firebase.google.com, enable Firestore (Native mode), then
# create a service account under Project Settings -> Service Accounts ->
# "Generate new private key". That downloads a JSON file - copy these three
# values out of it:
FIREBASE_PROJECT_ID=replace_with_project_id
FIREBASE_CLIENT_EMAIL=replace_with_client_email
# Paste the full "private_key" value from the JSON file, including the
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY----- lines. If you're
# pasting this into a .env file, wrap it in quotes and keep the \n escapes
# as-is (don't turn them into real line breaks) - the app converts them back
# to real newlines itself.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_your_key\n-----END PRIVATE KEY-----\n"

# development | production
NODE_ENV=development
